{
  "name": "hourly",
  "version": "1.0.0",
  "description": "Hourly - Aplicación web de control de horas de trabajo para freelancers",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently \"npm run dev\" \"npm run worker:dev\"",
    "dev:frontend": "vite",
    "dev:worker": "npx wrangler dev src/worker.js --config wrangler.toml",
    "deploy": "npm run build && npx wrangler pages deploy public",
    "build": "vite build",
    "preview": "vite preview",
    "db:create": "npx wrangler d1 create hourly-db",
    "db:migrate": "npx wrangler d1 migrations apply hourly-db --local",
    "db:migrate:prod": "npx wrangler d1 migrations apply hourly-db",
    "db:studio": "npx wrangler d1 execute hourly-db --local --command='SELECT * FROM users'",
    "worker:dev": "npx wrangler dev src/worker.js --config wrangler.toml",
    "worker:deploy": "npx wrangler deploy src/worker.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "date-fns": "^2.30.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.8",
    "wrangler": "^4.44.0"
  }
}
